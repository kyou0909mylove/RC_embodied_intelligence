+                if item["delivered"] >= item["expected"]:
+                    item["status"] = "COMPLETE"
+                    continue
+                if (item["pregrasp_failures"] >= strategy["max_pregrasp_failures"]
+                        or item["grasp_attempts"] >= strategy["max_grasp_attempts"]):
+                    item["status"] = "ATTEMPT_LIMIT"
+                    continue
